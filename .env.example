# ── LLM anahtarları (GitHub Actions secrets'ta tanımlanır) ───────────────────

# Groq (çeviri, review, QA düzeltmeleri) — https://console.groq.com
# Her key AYRI bir Groq hesabından olmalı: TPM havuzu hesap başınadır, aynı
# hesaptan alınan key'ler havuzu paylaşır ve rotasyonun bir faydası olmaz.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
# Tek key kullanıyorsan yukarıdakiler yerine bu da çalışır:
GROQ_API_KEY=

# Gemini (QA denetimi, seri önerileri) — https://aistudio.google.com/app/apikey
# Ek key'ler GEMINI_API_KEY_2, _3 ... şeklinde sırayla eklenir.
GEMINI_API_KEY=
GEMINI_API_KEY_2=

# ── Vercel (site / api) ortam değişkenleri ───────────────────────────────────

# GitHub Personal Access Token (sunucu tarafında kalır, tarayıcıya çıkmaz)
# Gerekli izinler: Contents (read/write), Actions (write)
GH_PAT=

# Repo adı (kullanıcıadı/repo-adı formatında)
GH_REPO=kullaniciadi/eptran

# Branch (varsayılan: main)
GH_BRANCH=main

# Yükleme formunun şifresi (api/upload.js) — istediğin güçlü bir rastgele metin
UPLOAD_SECRET=

# GitHub App (kısa ömürlü yükleme token'ı için; Actions'taki secret'larla aynı değerler)
APP_ID=
APP_PRIVATE_KEY=
